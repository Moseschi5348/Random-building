generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  MEMBER
  DEPARTMENT_HEAD
  ADMIN
}

enum PointSourceType {
  MEETING_ATTENDANCE
  QUIZ_GAME
  ADMIN_ADJUSTMENT
}

enum ResourceCategory {
  DESIGN
  REPO
  DOCUMENT
  TOOL
  OTHER
}

enum NoticeLevel {
  EMERGENCY
  IMPORTANT
  GENERAL
}

enum QuizStatus {
  DRAFT
  LOBBY
  LIVE
  COMPLETED
  CANCELLED
}

enum CommunityRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum CommunityGameKey {
  CHESS
  QUIZ
  WORDS
}

enum CommunityMeetupKey {
  CHESS
  ART
}

model User {
  id                  String                    @id @default(cuid())
  name                String                    @db.VarChar(120)
  email               String                    @unique @db.VarChar(254)
  passwordHash        String?
  googleId            String?                   @unique
  emailVerified       Boolean                   @default(false)
  role                UserRole                  @default(MEMBER)
  points              Int                       @default(0)
  isActive            Boolean                   @default(true)
  departmentId        String?
  department          Department?               @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  headedDepartment    Department?               @relation("DepartmentHead")
  sessions            Session[]
  attendances         Attendance[]
  badges              UserBadge[]
  transactions        PointTransaction[]
  resources           Resource[]
  hostedMeetings      Meeting[]                 @relation("MeetingHost")
  hostedQuizzes       Quiz[]                    @relation("QuizHost")
  quizParticipations  QuizParticipant[]
  communityVisible    Boolean                   @default(false)
  communityInterests  String[]                  @default([])
  sentConnections     CommunityConnection[]     @relation("ConnectionRequester")
  receivedConnections CommunityConnection[]     @relation("ConnectionRecipient")
  sentGameInvites     CommunityGameInvite[]     @relation("GameInviteSender")
  receivedGameInvites CommunityGameInvite[]     @relation("GameInviteRecipient")
  meetupInterests     CommunityMeetupInterest[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([departmentId])
  @@index([points(sort: Desc)])
}

model Department {
  id          String     @id @default(cuid())
  name        String     @unique @db.VarChar(120)
  description String     @db.VarChar(2000)
  icon        String     @default("◈") @db.VarChar(16)
  headId      String?    @unique
  head        User?      @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  members     User[]     @relation("DepartmentMembers")
  meetings    Meeting[]
  resources   Resource[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Meeting {
  id             String       @id @default(cuid())
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  title          String       @db.VarChar(160)
  description    String       @db.VarChar(2000)
  startsAt       DateTime
  endsAt         DateTime
  attendanceCode String?      @db.VarChar(12)
  codeExpiresAt  DateTime?
  createdById    String
  createdBy      User         @relation("MeetingHost", fields: [createdById], references: [id], onDelete: Restrict)
  attendances    Attendance[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([departmentId, startsAt])
  @@index([startsAt])
}

model Attendance {
  id            String   @id @default(cuid())
  userId        String
  meetingId     String
  punctual      Boolean  @default(false)
  pointsAwarded Int
  checkedInAt   DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  meeting       Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([userId, meetingId])
  @@index([userId])
  @@index([meetingId])
}

model PointTransaction {
  id         String          @id @default(cuid())
  userId     String
  amount     Int
  reason     String          @db.VarChar(255)
  sourceType PointSourceType
  sourceId   String?
  createdAt  DateTime        @default(now())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([sourceType, createdAt])
}

model Resource {
  id           String           @id @default(cuid())
  departmentId String
  userId       String
  title        String           @db.VarChar(160)
  url          String           @db.VarChar(2000)
  category     ResourceCategory @default(OTHER)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  department   Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([departmentId, createdAt])
  @@index([userId, createdAt])
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  key       String   @db.VarChar(64)
  awardedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.VarChar(64)
  csrfToken String   @db.VarChar(64)
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model StudentLifeNotice {
  id        String      @id @default(cuid())
  title     String      @db.VarChar(160)
  message   String      @db.VarChar(2000)
  level     NoticeLevel @default(GENERAL)
  startsAt  DateTime    @default(now())
  endsAt    DateTime?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([isActive, startsAt])
  @@index([endsAt])
}

model Quiz {
  id                      String            @id @default(cuid())
  title                   String            @db.VarChar(160)
  description             String?           @db.VarChar(1000)
  joinCode                String?           @unique @db.VarChar(6)
  status                  QuizStatus        @default(DRAFT)
  currentQuestionPosition Int               @default(0)
  questionStartedAt       DateTime?
  startedAt               DateTime?
  finishedAt              DateTime?
  createdById             String
  createdBy               User              @relation("QuizHost", fields: [createdById], references: [id], onDelete: Restrict)
  questions               QuizQuestion[]
  participants            QuizParticipant[]
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([createdById, createdAt])
  @@index([status, createdAt])
}

model QuizQuestion {
  id               String       @id @default(cuid())
  quizId           String
  position         Int
  prompt           String       @db.VarChar(1000)
  timeLimitSeconds Int          @default(30)
  quiz             Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options          QuizOption[]
  answers          QuizAnswer[]
  createdAt        DateTime     @default(now())

  @@unique([quizId, position])
}

model QuizOption {
  id         String       @id @default(cuid())
  questionId String
  text       String       @db.VarChar(300)
  isCorrect  Boolean      @default(false)
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers    QuizAnswer[]
}

model QuizParticipant {
  id         String       @id @default(cuid())
  quizId     String
  userId     String
  score      Int          @default(0)
  joinedAt   DateTime     @default(now())
  finishedAt DateTime?
  quiz       Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers    QuizAnswer[]

  @@unique([quizId, userId])
  @@index([quizId, score])
}

model QuizAnswer {
  id            String          @id @default(cuid())
  participantId String
  questionId    String
  optionId      String
  isCorrect     Boolean
  pointsAwarded Int             @default(0)
  answeredAt    DateTime        @default(now())
  participant   QuizParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  question      QuizQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option        QuizOption      @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@unique([participantId, questionId])
  @@index([questionId])
}

model CommunityConnection {
  id          String                 @id @default(cuid())
  requesterId String
  recipientId String
  status      CommunityRequestStatus @default(PENDING)
  requester   User                   @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient   User                   @relation("ConnectionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([requesterId, recipientId])
  @@index([recipientId, status])
}

model CommunityGameInvite {
  id          String                 @id @default(cuid())
  senderId    String
  recipientId String
  game        CommunityGameKey
  status      CommunityRequestStatus @default(PENDING)
  sender      User                   @relation("GameInviteSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User                   @relation("GameInviteRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([senderId, recipientId, status])
  @@index([recipientId, status])
}

model CommunityMeetupInterest {
  id        String             @id @default(cuid())
  userId    String
  meetup    CommunityMeetupKey
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())

  @@unique([userId, meetup])
  @@index([meetup])
}
